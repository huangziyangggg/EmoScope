<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════════════════════
         EmoScope 轻量化 Material 3 主题
         ═══════════════════════════════════════════════════════════ -->

    <style name="Base.Theme.EmoScope" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 统一中英文界面字形；缺失字形仍由 Android 系统安全回退。 -->
        <item name="android:fontFamily">@font/xinjing_sans</item>
        <!-- Primary -->
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>
        <!-- Secondary -->
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>
        <!-- Tertiary -->
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_light_onTertiaryContainer</item>
        <!-- Error -->
        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>
        <item name="colorErrorContainer">@color/md_theme_light_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_light_onErrorContainer</item>
        <!-- Background / Surface -->
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorOnBackground">@color/md_theme_light_onBackground</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        <!-- Surface Container M3 层级 -->
        <item name="colorSurfaceContainerLowest">@color/md_theme_light_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_light_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/md_theme_light_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_light_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md_theme_light_surfaceContainerHighest</item>
        <!-- Outline -->
        <item name="colorOutline">@color/md_theme_light_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_light_outlineVariant</item>
        <!-- Inverse -->
        <item name="colorSurfaceInverse">@color/md_theme_light_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_light_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_light_inversePrimary</item>

        <!-- Status / Navigation Bar — 沉浸式 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- Shape -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.EmoScope.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.EmoScope.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.EmoScope.Large</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.EmoScope.AlertDialog</item>

        <!-- Bottom Nav — 无阴影、背景跟随 Surface Container -->
        <item name="bottomNavigationStyle">@style/Widget.EmoScope.BottomNav</item>
        <item name="snackbarStyle">@style/Widget.EmoScope.Snackbar</item>
    </style>

    <style name="Theme.EmoScope" parent="Base.Theme.EmoScope" />

    <!-- Splash Screen (Android 12+) -->
    <style name="Theme.EmoScope.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/md_theme_light_surface</item>
        <item name="postSplashScreenTheme">@style/Theme.EmoScope</item>
    </style>

    <!-- Bottom Nav 定制 — 无 elevation、透明背景 -->
    <style name="Widget.EmoScope.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.EmoScope.BottomNav</item>
    </style>

    <style name="ThemeOverlay.EmoScope.BottomNav" parent="">
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- 全局 Material 对话框：柔和表面、清晰文字、统一紫色操作。 -->
    <style name="ThemeOverlay.EmoScope.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearance">@style/ShapeAppearance.EmoScope.Dialog</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/glass_ink</item>
        <item name="colorPrimary">@color/glass_violet</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.EmoScope.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.EmoScope.Dialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.EmoScope.DialogButton.Primary</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.EmoScope.DialogButton.Secondary</item>
    </style>

    <style name="Widget.EmoScope.DialogButton.Primary" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="backgroundTint">@color/glass_violet</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="shapeAppearance">@style/ShapeAppearance.EmoScope.DialogAction</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="Widget.EmoScope.DialogButton.Secondary" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/glass_violet</item>
    </style>

    <style name="TextAppearance.EmoScope.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:fontFamily">@font/xinjing_sans</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.EmoScope.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:fontFamily">@font/xinjing_sans</item>
    </style>

    <style name="Widget.EmoScope.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/glass_ink</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="shapeAppearance">@style/ShapeAppearance.EmoScope.DialogAction</item>
    </style>

    <!-- 首页入口副标题 — 始终显示，允许换行 -->
    <style name="Widget.EmoScope.HomeEntryBody" parent="">
    </style>
</resources>
