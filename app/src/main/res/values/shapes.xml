<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ═══════════════════════════════════════════════════════════
         EmoScope Material 3 Shape Appearances
         ═══════════════════════════════════════════════════════════ -->

    <!-- Small: 芯片、小按钮、工具栏图标 -->
    <style name="ShapeAppearance.EmoScope.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!-- Medium: 标准卡片、对话框、设置项 -->
    <style name="ShapeAppearance.EmoScope.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Large: 大卡片 — 更柔和的圆角 -->
    <style name="ShapeAppearance.EmoScope.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- 对话框使用更舒展的圆角，和内容卡片形成清晰层级。 -->
    <style name="ShapeAppearance.EmoScope.Dialog" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.EmoScope.DialogAction" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- 导航栏选中指示器：透明占位，避免挤压图标和文字 -->
    <style name="Widget.EmoScope.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:shape">rectangle</item>
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">1dp</item>
        <item name="android:color">@android:color/transparent</item>
        <item name="android:height">1dp</item>
        <item name="android:width">1dp</item>
    </style>
</resources>
