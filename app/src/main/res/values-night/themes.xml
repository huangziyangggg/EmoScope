<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.EmoScope" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/xinjing_sans</item>
        <item name="colorPrimary">@color/md_theme_dark_primary</item>
        <item name="colorOnPrimary">@color/md_theme_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_dark_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_dark_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_dark_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_dark_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_dark_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_dark_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_dark_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_dark_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_dark_onTertiaryContainer</item>
        <item name="colorError">@color/md_theme_dark_error</item>
        <item name="colorOnError">@color/md_theme_dark_onError</item>
        <item name="colorErrorContainer">@color/md_theme_dark_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_dark_onErrorContainer</item>
        <item name="android:colorBackground">@color/md_theme_dark_background</item>
        <item name="colorOnBackground">@color/md_theme_dark_onBackground</item>
        <item name="colorSurface">@color/md_theme_dark_surface</item>
        <item name="colorOnSurface">@color/md_theme_dark_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_dark_onSurfaceVariant</item>
        <item name="colorSurfaceContainerLowest">@color/md_theme_dark_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_dark_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/md_theme_dark_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_dark_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md_theme_dark_surfaceContainerHighest</item>
        <item name="colorOutline">@color/md_theme_dark_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_dark_outlineVariant</item>
        <item name="colorSurfaceInverse">@color/md_theme_dark_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_dark_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_dark_inversePrimary</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.EmoScope.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.EmoScope.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.EmoScope.Large</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.EmoScope.AlertDialog.Dark</item>

        <item name="bottomNavigationStyle">@style/Widget.EmoScope.BottomNav.Dark</item>
        <item name="snackbarStyle">@style/Widget.EmoScope.Snackbar.Dark</item>
    </style>

    <style name="Theme.EmoScope.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/md_theme_dark_surface</item>
        <item name="postSplashScreenTheme">@style/Theme.EmoScope</item>
    </style>

    <style name="Widget.EmoScope.BottomNav.Dark" parent="Widget.Material3.BottomNavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.EmoScope.BottomNav.Dark</item>
    </style>

    <style name="ThemeOverlay.EmoScope.BottomNav.Dark" parent="">
        <item name="colorSurface">@color/md_theme_dark_surface</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="ThemeOverlay.EmoScope.AlertDialog.Dark" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearance">@style/ShapeAppearance.EmoScope.Dialog</item>
        <item name="colorSurface">@color/md_theme_dark_surface</item>
        <item name="colorOnSurface">@color/md_theme_dark_onSurface</item>
        <item name="colorPrimary">@color/md_theme_dark_primary</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.EmoScope.Dialog.Title.Dark</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.EmoScope.Dialog.Body.Dark</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.EmoScope.DialogButton.Primary.Dark</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.EmoScope.DialogButton.Secondary.Dark</item>
    </style>

    <style name="Widget.EmoScope.DialogButton.Primary.Dark" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="backgroundTint">@color/md_theme_dark_primary</item>
        <item name="android:textColor">@color/md_theme_dark_onPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="shapeAppearance">@style/ShapeAppearance.EmoScope.DialogAction</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="Widget.EmoScope.DialogButton.Secondary.Dark" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/md_theme_dark_primary</item>
    </style>

    <style name="TextAppearance.EmoScope.Dialog.Title.Dark" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:fontFamily">@font/xinjing_sans</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.EmoScope.Dialog.Body.Dark" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:fontFamily">@font/xinjing_sans</item>
    </style>

    <style name="Widget.EmoScope.Snackbar.Dark" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/md_theme_dark_surfaceContainerHigh</item>
        <item name="android:textColor">@color/md_theme_dark_onSurface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.EmoScope.DialogAction</item>
    </style>
</resources>
