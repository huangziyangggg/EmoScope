<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_canvas"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_horizontal_padding"
    android:paddingTop="@dimen/page_top_padding"
    android:paddingEnd="@dimen/page_horizontal_padding">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/history_header_height">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="情绪记录"
                android:textColor="@color/glass_ink"
            android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="看见自己的节奏，而不是评判它"
                android:textColor="@color/glass_ink_soft"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="-6dp"
            android:gravity="center"
            android:text="✦"
            android:textColor="@color/glass_violet"
            android:textSize="24sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnHistoryMore"
            android:layout_width="@dimen/home_action_size"
            android:layout_height="@dimen/home_action_size"
            android:layout_gravity="end|top"
            android:clickable="true"
            android:contentDescription="更多"
            android:focusable="true"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_history_more"
                android:contentDescription="更多"
                android:padding="18dp"
                android:src="@drawable/ic_more"
                app:tint="@color/glass_violet" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="@dimen/history_summary_height"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:shapeAppearance="?attr/shapeAppearanceLargeComponent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_history_panel"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/history_stats_row_height"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_empty_clipboard"
                        app:tint="@color/glass_violet" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="总记录"
                        android:textColor="@color/glass_ink_soft"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvStatTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0"
                        android:textColor="@color/glass_ink"
                        android:textSize="27sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="0.5dp"
                    android:layout_height="@dimen/history_stats_divider_height"
                    android:layout_gravity="center_vertical"
                    android:background="@color/glass_stroke" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_mood_smile"
                        app:tint="@color/positive_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="积极"
                        android:textColor="@color/glass_ink_soft"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvStatPos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0"
                        android:textColor="@color/positive_green"
                        android:textSize="27sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="0.5dp"
                    android:layout_height="@dimen/history_stats_divider_height"
                    android:layout_gravity="center_vertical"
                    android:background="@color/glass_stroke" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_filter_warning"
                        app:tint="@color/warning_orange" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="关注"
                        android:textColor="@color/glass_ink_soft"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvStatNeg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0"
                        android:textColor="@color/danger_red"
                        android:textSize="27sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="0.5dp"
                    android:layout_height="@dimen/history_stats_divider_height"
                    android:layout_gravity="center_vertical"
                    android:background="@color/glass_stroke" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_workshop_prediction"
                        app:tint="@color/home_entry_voice" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="均值"
                        android:textColor="@color/glass_ink_soft"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvStatAvg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="--"
                        android:textColor="@color/home_entry_voice"
                        android:textSize="27sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_history_chart_soft"
                android:padding="4dp">

                <FrameLayout
                    android:id="@+id/chartContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tvChartEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="写下三次此刻，\n这里会慢慢显出属于你的节奏"
                    android:textColor="@color/glass_ink_muted"
                    android:textSize="14sp" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/history_filter_height"
        android:layout_marginTop="@dimen/item_spacing"
        android:background="@drawable/bg_history_filter_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="5dp">

        <TextView
            android:id="@+id/filterAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_history_filter_selected"
            android:gravity="center"
            android:text="全部"
            android:textColor="@color/glass_violet"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filterWeek"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="7 天"
            android:textColor="@color/glass_ink_soft"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filterMonth"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="30 天"
            android:textColor="@color/glass_ink_soft"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0.5dp"
            android:layout_height="30dp"
            android:background="@color/glass_stroke" />

        <ImageView
            android:id="@+id/filterPositive"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:contentDescription="积极记录"
            android:padding="13dp"
            android:src="@drawable/ic_filter_positive"
            app:tint="@color/glass_ink_soft" />

        <ImageView
            android:id="@+id/filterWarning"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:contentDescription="关注记录"
            android:padding="13dp"
            android:src="@drawable/ic_filter_warning"
            app:tint="@color/glass_ink_soft" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/item_spacing"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistory"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/page_bottom_safe_padding" />

            <TextView
                android:id="@+id/tvHistoryEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="这里还没有记录。\n从一次真实感受开始。"
                android:textColor="@color/glass_ink_muted"
                android:textSize="15sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHistoryEmptyRecord"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:translationY="62dp"
                android:visibility="gone"
                android:text="开始记录"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/glass_violet"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_workshop_journal"
                app:iconPadding="8dp"
                app:iconTint="@android:color/white" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
