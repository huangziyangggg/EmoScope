<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_liquid_canvas">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/radarScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="132dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/llScrollContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="44dp">

            <LinearLayout
                android:id="@+id/topToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDateTop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="今天"
                        android:textColor="@color/glass_ink_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDynamicGreeting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/greeting_default"
                        android:textColor="@color/glass_ink"
                        android:textSize="30sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnTtsToggle"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:clickable="true"
                    android:contentDescription="切换语音播报"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/glass_panel"
                    app:cardElevation="0dp"
                    app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
                    app:strokeColor="@color/glass_stroke"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:id="@+id/tvTtsIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="切换语音播报"
                        android:padding="11dp"
                        android:src="@drawable/ic_tts_on" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvSOS"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                app:cardBackgroundColor="@color/glass_rose_soft"
                app:cardElevation="0dp"
                app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
                app:strokeColor="@color/glass_rose"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="紧急干预"
                        android:src="@drawable/ic_sos" />

                    <TextView
                        android:id="@+id/btnSOS"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="需要帮助"
                        android:textColor="@color/danger_red"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnQuickMood"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="40dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/glass_panel"
                app:cardElevation="0dp"
                app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
                app:strokeColor="@color/deco_outline_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_home_icon_record"
                        android:contentDescription="快速记录"
                        android:padding="13dp"
                        android:src="@drawable/ic_mood_smile"
                        app:tint="@color/home_entry_record" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="快速记录"
                            android:textColor="@color/glass_ink"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="手动写下此刻情绪"
                            android:textColor="@color/glass_ink_soft"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="116dp"
                android:layout_marginTop="12dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnContainerMain"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/glass_panel"
                    app:cardElevation="0dp"
                    app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
                    app:strokeColor="@color/deco_outline_variant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="18dp">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_home_icon_voice"
                            android:contentDescription="语音倾诉"
                            android:padding="13dp"
                            android:src="@drawable/ic_mic"
                            app:tint="@color/home_entry_voice" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/btnSpeakMain"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="按住说话"
                                android:textColor="@color/glass_ink"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="用语音获得 AI 陪伴"
                                android:textColor="@color/glass_ink_soft"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.example.emoscope.SonarRippleView
                    android:id="@+id/sonarRipple"
                    android:layout_width="132dp"
                    android:layout_height="132dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <com.example.emoscope.VoiceWaveView
                    android:id="@+id/voiceWaveView"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </FrameLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvFaceAnalysis"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/glass_panel"
                app:cardElevation="0dp"
                app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
                app:strokeColor="@color/deco_outline_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_home_icon_face"
                        android:contentDescription="面容分析"
                        android:padding="13dp"
                        android:src="@drawable/ic_face_scan"
                        app:tint="@color/home_entry_face" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="面容分析"
                            android:textColor="@color/glass_ink"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnOpenFaceCamera"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="打开相机识别状态"
                            android:textColor="@color/glass_ink_soft"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvAiResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/glass_panel"
                app:cardElevation="0dp"
                app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
                app:strokeColor="@color/deco_outline_variant"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvAiTyping"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="5dp"
                    android:padding="18dp"
                    android:textColor="@color/glass_ink"
                    android:textSize="15sp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ImageView
        android:id="@+id/ivGreetingIcon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
