<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_liquid_canvas">

    <!-- ═══════════════════════════════════════════════════════════
         Fragment 容器 — 承载 3 个页面 (Radar / History / Settings)
         ═══════════════════════════════════════════════════════════ -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav" />

    <!-- ═══════════════════════════════════════════════════════════
         沉浸式人脸识别舱 (Camera Mode) — 覆在所有 Fragment 之上
         ═══════════════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCameraMode"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="@android:color/black"
        android:fitsSystemWindows="true"
        android:elevation="50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnCloseCamera"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="48dp"
            app:cardBackgroundColor="@color/overlay_dark_30"
            app:shapeAppearance="?attr/shapeAppearanceSmallComponent"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:src="@drawable/ic_close"
                android:contentDescription="关闭相机" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnFlipCamera"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="48dp"
            app:cardBackgroundColor="@color/overlay_dark_30"
            app:shapeAppearance="?attr/shapeAppearanceSmallComponent"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="11dp"
                android:src="@drawable/ic_flip"
                android:contentDescription="翻转相机" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 拍照打分按钮 — 核心交互 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnCaptureFace"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="3dp"
            app:layout_constraintBottom_toTopOf="@id/cardFaceResult"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp"
                android:src="@drawable/ic_face_scan"
                android:contentDescription="拍照打分"
                app:tint="#FFFFFF" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="轻触圆圈拍照"
            android:textColor="@color/overlay_white_90"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/btnCaptureFace"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 拍照结果卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFaceResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="120dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/glass_panel"
            app:cardElevation="2dp"
            app:shapeAppearance="?attr/shapeAppearanceLargeComponent"
            app:layout_constraintBottom_toBottomOf="parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvCaptureScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/glass_ink"
                    android:textSize="52sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/ 100 分"
                    android:textColor="@color/glass_ink_soft"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tvCaptureEmotions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/glass_ink_soft"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnSaveCapture"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/glass_ink"
                        app:cardElevation="0dp"
                        app:shapeAppearance="?attr/shapeAppearanceMediumComponent">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="保存记录"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnDiscardCapture"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/glass_panel_strong"
                        app:cardElevation="0dp"
                        app:shapeAppearance="?attr/shapeAppearanceMediumComponent">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="丢弃"
                            android:textColor="@color/glass_ink_soft"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 实时表情信息卡 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="96dp"
            app:cardBackgroundColor="@color/overlay_white_90"
            app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
            app:cardElevation="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/tvCameraFaceEmoji"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_face_scan"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="面容分析状态" />
                    <TextView
                        android:id="@+id/tvCameraFaceState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="正在观察面部表情..."
                        android:textColor="@color/glass_ink"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>
                <!-- 实验性 rPPG 心率显示 -->
                <LinearLayout
                    android:id="@+id/llRppgDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="♥"
                        android:textColor="@color/danger_red"
                        android:textSize="16sp"
                        android:layout_marginEnd="6dp" />
                    <TextView
                        android:id="@+id/tvRppgBpm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/glass_ink"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" BPM"
                        android:textColor="@color/glass_ink_soft"
                        android:textSize="12sp"
                        android:layout_marginEnd="10dp" />
                    <TextView
                        android:id="@+id/tvRppgQuality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/filter_pill"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="实验性"
                        android:textColor="@color/glass_ink_soft"
                        android:textSize="10sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvCameraProb1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/glass_ink_soft"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/tvCameraProb2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/glass_ink_soft"
                    android:textSize="13sp"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/tvCameraProb3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/glass_ink_soft"
                    android:textSize="13sp"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══════════════════════════════════════════════════════════
         SOS 呼吸急救遮罩 — 最高层级，覆盖所有内容
         ═══════════════════════════════════════════════════════════ -->
    <!-- Voice Mode overlay: opened from the home voice card, like camera mode. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutVoiceMode"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_home_canvas"
        android:elevation="55dp"
        android:fitsSystemWindows="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnCloseVoice"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="48dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/glass_panel"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
            app:strokeColor="@color/deco_outline_variant"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="关闭语音倾诉"
                android:padding="13dp"
                android:src="@drawable/ic_close"
                app:tint="@color/glass_ink" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/voiceModeContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvVoiceTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="语音倾诉"
                android:textColor="@color/glass_ink"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVoiceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="进入后点按下方按钮，说出此刻的感受。"
                android:textColor="@color/glass_ink_soft"
                android:textSize="16sp" />

            <FrameLayout
                android:layout_width="148dp"
                android:layout_height="148dp"
                android:layout_marginTop="32dp">

                <com.example.emoscope.SonarRippleView
                    android:id="@+id/voiceModeSonarRipple"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <com.example.emoscope.VoiceWaveView
                    android:id="@+id/voiceModeWaveView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnVoiceStartStop"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/home_entry_voice_soft"
                    app:cardElevation="0dp"
                    app:shapeAppearance="?attr/shapeAppearanceLargeComponent"
                    app:strokeColor="@color/deco_outline_variant"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="开始或停止语音识别"
                        android:padding="34dp"
                        android:src="@drawable/ic_mic"
                        app:tint="@color/home_entry_voice" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <TextView
                android:id="@+id/tvVoiceAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="开始倾诉"
                android:textColor="@color/home_entry_voice"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="@color/glass_panel"
                app:cardElevation="0dp"
                app:shapeAppearance="?attr/shapeAppearanceLargeComponent"
                app:strokeColor="@color/deco_outline_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="识别内容"
                        android:textColor="@color/glass_ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvVoiceTranscript"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="5dp"
                        android:text="还没有开始。"
                        android:textColor="@color/glass_ink_soft"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvVoiceHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="4dp"
                        android:text="如果设备没有系统语音服务，请先安装或启用 Google App / Google 语音搜索。"
                        android:textColor="@color/glass_ink_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutBreathing"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/overlay_dark_92"
        android:elevation="60dp"
        android:visibility="gone"
        android:fitsSystemWindows="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.example.emoscope.BreathingOverlayView
            android:id="@+id/breathOverlay"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/breathCircle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvBreathText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="慢慢吸气..."
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="60dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已向紧急联系人发送求助短信"
                android:textColor="@color/overlay_white_50"
                android:textSize="11sp"
                android:layout_marginBottom="20dp"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnCloseBreath"
                android:layout_width="200dp"
                android:layout_height="50dp"
                android:contentDescription="结束呼吸练习"
                app:cardBackgroundColor="@color/overlay_white_20"
                app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
                app:cardElevation="0dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="我已平静下来"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnCallHotline"
                android:layout_width="200dp"
                android:layout_height="50dp"
                android:contentDescription="拨打全国援助热线"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?attr/colorError"
                app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_phone"
                        android:contentDescription="电话" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="拨打全国援助热线"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══════════════════════════════════════════════════════════
         底部导航栏
         ═══════════════════════════════════════════════════════════ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_nav_height"
        android:background="@drawable/bg_glass_nav"
        android:elevation="0dp"
        android:minHeight="@dimen/bottom_nav_height"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="@dimen/bottom_nav_bottom_margin"
        android:paddingTop="@dimen/bottom_nav_padding_top"
        android:paddingBottom="@dimen/bottom_nav_padding_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconSize="@dimen/bottom_nav_icon_size"
        app:itemTextAppearanceActive="@style/TextAppearance.EmoScope.BottomNavLabel"
        app:itemTextAppearanceInactive="@style/TextAppearance.EmoScope.BottomNavLabel"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/bottom_nav_tint"
        app:itemTextColor="@color/bottom_nav_tint"
        app:itemActiveIndicatorStyle="@style/Widget.EmoScope.NavIndicator" />

</androidx.constraintlayout.widget.ConstraintLayout>
