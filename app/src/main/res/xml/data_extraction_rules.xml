<?xml version="1.0" encoding="utf-8"?>
<!--
    EmoScope 数据提取规则 (API 31+)
    云备份和设-设迁移：排除 SharedPreferences 私密数据，保留数据库。
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
