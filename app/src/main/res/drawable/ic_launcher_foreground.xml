<?xml version="1.0" encoding="utf-8"?>
<!-- EmoScope 启动图标前景 — 情绪脉动扫描
     三重交叠圆环 + 中心脉动点，代表情绪扫描的三个维度：
     面容分析 · 声纹张力 · 环境光感 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 底部光环 — 柔和散射 -->
    <path
        android:pathData="M54,54 m-28,0 a28,28 0,1 0,56 0 a28,28 0,1 0,-56 0"
        android:fillColor="#33FFFFFF" />

    <!-- 圆环 1: 面容分析 — 上方偏左 -->
    <path
        android:pathData="M40,36 m-12,0 a12,12 0,1 0,24 0 a12,12 0,1 0,-24 0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:fillColor="@android:color/transparent"
        android:strokeAlpha="0.8" />

    <!-- 圆环 2: 声纹张力 — 上方偏右 -->
    <path
        android:pathData="M68,36 m-12,0 a12,12 0,1 0,24 0 a12,12 0,1 0,-24 0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:fillColor="@android:color/transparent"
        android:strokeAlpha="0.8" />

    <!-- 圆环 3: 环境光感 — 下方居中 -->
    <path
        android:pathData="M54,60 m-14,0 a14,14 0,1 0,28 0 a14,14 0,1 0,-28 0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:fillColor="@android:color/transparent"
        android:strokeAlpha="0.8" />

    <!-- 中心脉动点 -->
    <path
        android:pathData="M54,44 m-4,0 a4,4 0,1 0,8 0 a4,4 0,1 0,-8 0"
        android:fillColor="#FFFFFF" />

    <!-- 脉动信号弧线 — 从中心向右上扩散 -->
    <path
        android:pathData="M58,44 C62,36 72,30 80,32"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:fillColor="@android:color/transparent"
        android:strokeAlpha="0.6"
        android:strokeLineCap="round" />

    <!-- 脉动信号弧线 — 从中心向左下扩散 -->
    <path
        android:pathData="M50,48 C46,54 38,60 30,58"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:fillColor="@android:color/transparent"
        android:strokeAlpha="0.4"
        android:strokeLineCap="round" />

</vector>
