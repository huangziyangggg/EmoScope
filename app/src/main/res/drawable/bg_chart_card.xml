<?xml version="1.0" encoding="utf-8"?>
<!-- 图表卡片 — 极淡紫色渐变背景 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#08A78BFA"
        android:centerColor="#03A78BFA"
        android:endColor="#00FFFFFF"
        android:type="linear" />
    <corners android:radius="24dp" />
    <stroke
        android:width="0.5dp"
        android:color="@color/deco_outline_variant" />
</shape>
