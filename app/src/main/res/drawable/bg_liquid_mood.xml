<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_panel_strong" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
            <corners android:radius="34dp" />
        </shape>
    </item>
    <item android:top="0dp" android:left="0dp" android:right="110dp" android:bottom="120dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="150dp"
                android:startColor="#66DDEEFF"
                android:endColor="#00DDEEFF" />
        </shape>
    </item>
    <item android:top="105dp" android:left="150dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="130dp"
                android:startColor="#66FFEBDD"
                android:endColor="#00FFEBDD" />
        </shape>
    </item>
</layer-list>
